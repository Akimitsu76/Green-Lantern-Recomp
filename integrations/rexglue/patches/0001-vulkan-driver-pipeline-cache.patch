+// Driver data is private to this machine; shareable .xsh/.xpso remain unchanged.
+// Envelope catches truncation/accidental corruption before handing opaque bytes
+// back to the driver. XXH3 is an integrity check, not an authenticity guarantee.
+namespace {
+constexpr uint64_t kDriverCacheMagic = 0x3145484341435841ull;  // AXCACHE1
+constexpr size_t kDriverCacheMaxBytes = 64 * 1024 * 1024;
+constexpr size_t kDriverCacheHeaderBytes = 32;  // Vulkan header version one.
+}
+
+void VulkanPipelineCache::InitializeDriverCache(const std::filesystem::path& cache_root,
+                                                 uint32_t title_id) {
+  std::unique_lock<std::shared_mutex> lock(driver_cache_mutex_);
+  const auto* vulkan_device = command_processor_.GetVulkanDevice();
+  const auto& ifn = vulkan_device->vulkan_instance()->functions();
+  const VkDevice device = vulkan_device->device();
+  create_driver_cache_ = reinterpret_cast<PFN_vkCreatePipelineCache>(
+      ifn.vkGetDeviceProcAddr(device, "vkCreatePipelineCache"));
+  get_driver_cache_data_ = reinterpret_cast<PFN_vkGetPipelineCacheData>(
+      ifn.vkGetDeviceProcAddr(device, "vkGetPipelineCacheData"));
+  destroy_driver_cache_ = reinterpret_cast<PFN_vkDestroyPipelineCache>(
+      ifn.vkGetDeviceProcAddr(device, "vkDestroyPipelineCache"));
+  if (!create_driver_cache_ || !get_driver_cache_data_ || !destroy_driver_cache_) {
+    REXGPU_WARN("VulkanPipelineCache: Driver cache entry points unavailable");
+    return;
+  }
+
+  VkPhysicalDeviceProperties properties;
+  ifn.vkGetPhysicalDeviceProperties(vulkan_device->physical_device(), &properties);
+  std::string uuid;
+  for (uint8_t byte : properties.pipelineCacheUUID) {
+    uuid += fmt::format("{:02X}", byte);
+  }
+  bool fsi = render_target_cache_.GetPath() == RenderTargetCache::Path::kPixelShaderInterlock;
+  auto directory = cache_root / "shaders" / "driver";
+  std::error_code error;
+  std::filesystem::create_directories(directory, error);
+  if (!error) {
+    driver_cache_path_ = directory / fmt::format(
+        "{:08X}.{}.v1.{}bit.{:08X}.{:08X}.{:08X}.{:08X}.{}.vkcache", title_id,
+        fsi ? "fsi" : "fbo", sizeof(void*) * 8, properties.vendorID, properties.deviceID,
+        properties.driverVersion, properties.apiVersion, uuid);
+  } else {
+    REXGPU_WARN("VulkanPipelineCache: Driver cache directory unavailable: {}", error.message());
+  }
+
+  std::vector<uint8_t> data;
+  if (!driver_cache_path_.empty()) {
+    uintmax_t file_size = std::filesystem::file_size(driver_cache_path_, error);
+    if (!error && file_size >= 24 + kDriverCacheHeaderBytes &&
+        file_size <= 24 + kDriverCacheMaxBytes) {
+      if (FILE* file = rex::filesystem::OpenFile(driver_cache_path_, "rb")) {
+        uint64_t envelope[3] = {};
+        bool valid = fread(envelope, sizeof(envelope), 1, file) == 1 &&
+                     envelope[0] == kDriverCacheMagic && envelope[1] == file_size - 24;
+        if (valid) {
+          data.resize(size_t(envelope[1]));
+          valid = fread(data.data(), data.size(), 1, file) == 1 &&
+                  XXH3_64bits(data.data(), data.size()) == envelope[2];
+        }
+        fclose(file);
+        // Version-one Vulkan header is four uint32_t fields followed by UUID.
+        uint32_t header[4] = {};
+        if (valid) {
+          std::memcpy(header, data.data(), sizeof(header));
+          valid = header[0] >= kDriverCacheHeaderBytes && header[0] <= data.size() &&
+                  header[1] == VK_PIPELINE_CACHE_HEADER_VERSION_ONE &&
+                  header[2] == properties.vendorID && header[3] == properties.deviceID &&
+                  std::memcmp(data.data() + 16, properties.pipelineCacheUUID, VK_UUID_SIZE) == 0;
+        }
+        if (!valid) {
+          data.clear();
+          REXGPU_WARN("VulkanPipelineCache: Ignoring invalid/incompatible driver cache");
+        }
+      }
+    } else if (!error) {
+      REXGPU_WARN("VulkanPipelineCache: Ignoring driver cache with invalid size {}", file_size);
+    }
+  }
+
+  VkPipelineCacheCreateInfo info = {};
+  info.sType = VK_STRUCTURE_TYPE_PIPELINE_CACHE_CREATE_INFO;
+  // No EXTERNALLY_SYNCHRONIZED flag: parallel creation uses Vulkan's default
+  // internal synchronization. Our exclusive lock also makes snapshots stable.
+  info.initialDataSize = data.size();
+  info.pInitialData = data.empty() ? nullptr : data.data();
+  VkResult result = create_driver_cache_(device, &info, nullptr, &driver_cache_);
+  if (result != VK_SUCCESS && !data.empty()) {
+    REXGPU_WARN("VulkanPipelineCache: Driver rejected cached data ({}), retrying empty", int(result));
+    driver_cache_ = VK_NULL_HANDLE;
+    info.initialDataSize = 0;
+    info.pInitialData = nullptr;
+    result = create_driver_cache_(device, &info, nullptr, &driver_cache_);
+  }
+  if (result != VK_SUCCESS) {
+    driver_cache_ = VK_NULL_HANDLE;
+    REXGPU_WARN("VulkanPipelineCache: Driver cache unavailable ({})", int(result));
+  } else {
+    REXGPU_INFO("VulkanPipelineCache: Driver cache initialized with {} bytes", info.initialDataSize);
+  }
+}
+
+void VulkanPipelineCache::SaveDriverCache() {
+  std::unique_lock<std::shared_mutex> lock(driver_cache_mutex_);
+  if (driver_cache_ == VK_NULL_HANDLE) {
+    return;
+  }
+  uint64_t generation = driver_cache_generation_.load(std::memory_order_relaxed);
+  if (generation == driver_cache_saved_generation_) {
+    return;
+  }
+  const VkDevice device = command_processor_.GetVulkanDevice()->device();
+  size_t size = 0;
+  if (!driver_cache_path_.empty() &&
+      get_driver_cache_data_(device, driver_cache_, &size, nullptr) == VK_SUCCESS &&
+      size >= kDriverCacheHeaderBytes && size <= kDriverCacheMaxBytes) {
+    std::vector<uint8_t> data(size);
+    VkResult result = get_driver_cache_data_(device, driver_cache_, &size, data.data());
+    // Exclusive lock excludes every create call between size and data queries.
+    // Discard VK_INCOMPLETE rather than persisting a partial snapshot.
+    if (result == VK_SUCCESS && size >= kDriverCacheHeaderBytes && size <= data.size()) {
+      data.resize(size);
+      uint64_t envelope[3] = {kDriverCacheMagic, uint64_t(size), XXH3_64bits(data.data(), size)};
+      auto temporary = driver_cache_path_;
+      temporary += fmt::format(".{}.{}.tmp", reinterpret_cast<uintptr_t>(this),
+          std::chrono::steady_clock::now().time_since_epoch().count());
+      if (FILE* file = rex::filesystem::OpenFile(temporary, "wbx")) {
+        bool written = fwrite(envelope, sizeof(envelope), 1, file) == 1 &&
+                       fwrite(data.data(), size, 1, file) == 1;
+        written = fflush(file) == 0 && written;
+        written = fclose(file) == 0 && written;
+        std::error_code error;
+        if (written) {
+          // Same-directory rename preserves the previous complete cache on a
+          // failed write. Never delete the old destination to force a rename.
+          std::filesystem::rename(temporary, driver_cache_path_, error);
+          written = !error;
+        }
+        if (written) {
+          driver_cache_saved_generation_ = generation;
+          REXGPU_INFO("VulkanPipelineCache: Persisted {} driver cache bytes", size);
+        } else {
+          REXGPU_WARN("VulkanPipelineCache: Driver cache snapshot not saved");
+        }
+        std::filesystem::remove(temporary, error);
+      }
+    } else {
+      REXGPU_WARN("VulkanPipelineCache: Driver cache snapshot incomplete ({})", int(result));
+    }
+  }
+}
+
+void VulkanPipelineCache::ShutdownDriverCache() {
+  SaveDriverCache();
+  std::unique_lock<std::shared_mutex> lock(driver_cache_mutex_);
+  if (driver_cache_ == VK_NULL_HANDLE) {
+    driver_cache_path_.clear();
+    return;
+  }
+  destroy_driver_cache_(command_processor_.GetVulkanDevice()->device(), driver_cache_, nullptr);
+  driver_cache_ = VK_NULL_HANDLE;
+  driver_cache_path_.clear();
+  driver_cache_generation_.store(0, std::memory_order_relaxed);
+  driver_cache_saved_generation_ = 0;
+}
